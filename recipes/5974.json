      "type": "step",
      "heading": {
        "de": "Teig",
        "en": "Dough"
      },
      "text": {
        "de": "Hefe in warmer Milch auflösen und alle Zutaten vermischen.",
        "en": "Dissolve the yeast in warm milk and mix all the ingredients together."
      }
    },
    {
      "id": "c004",
      "type": "step",
      "heading": {
        "de": "Teig",
        "en": "Dough"
      },
      "text": {
        "de": "1-2 Stunden gehen lassen bis sich Volumen verdoppelt hat.",
        "en": "Let the dough rise for 1–2 hours until it has doubled in size."
      }
    },
    {
      "id": "c005",
      "type": "step",
      "heading": {
        "de": "Teig",
        "en": "Dough"
      },
      "text": {
        "de": "Teig ausrollen, mit Zimtfüllung bestreichen, teilen und ca. 40min gehen lassen.",
        "en": "Roll out the dough, spread it with the cinnamon filling, divide it, and let it rise for about 40 minutes."
      }
    },
    {
      "id": "c006",
      "type": "step",
      "heading": {
        "de": "Backen",
        "en": "Baking"
      },
      "text": {
        "de": "Anschließend etwas Milch hinzufügen und 25min bei 180 °C Ober/Unterhitze backen.",
        "en": "Then add milk and bake for 25 minutes at 180 °C (top and bottom heat)."
      }
    },
    {
      "id": "c007",
      "type": "step",
      "heading": {
        "de": "Frosting",
        "en": "Frosting"
      },
      "text": {
        "de": "Die Butter mit dem Zucker aufschlagen und Frischkäse unterrühren.",
        "en": "Beat the butter with the sugar, then mix in the cream cheese."
      }
    },
    {
      "id": "c008",
      "type": "step",
      "heading": {
        "de": "Frosting",
        "en": "Frosting"
      },
      "text": {
        "de": "Die warmen Zimtschnecken mit dem Frosting bestreichen und schmecken lassen.",
